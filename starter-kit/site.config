# Single source of truth. Every {{TOKEN}} in src/ is filled from here at build.
# The one rule that prevents the "canonical points at the wrong domain" bug:
# SITE_URL is defined ONCE and stamped into canonical, og:url, sitemap, robots.
# Format: KEY=value  (no quotes, no spaces around =)

# --- deployment (MUST match the host you actually deploy to; NO trailing slash)
SITE_URL=https://www.example.com

# --- identity
BUSINESS_NAME=Example Home Services
LANG=en-CA
OG_LOCALE=en_CA
THEME_COLOR=#1C1510
SCHEMA_TYPE=Plumber
PRICE_RANGE=$$
FOUNDING_YEAR=2009
SLOGAN=Fast, honest service you can count on.

# --- contact (real values only — the build refuses 555 numbers & placeholders)
PHONE_E164=+13065551234
PHONE_DISPLAY=(306) 555-1234
EMAIL=hello@example.com
WEB3FORMS_KEY=REPLACE_WITH_REAL_WEB3FORMS_KEY

# --- location
STREET=123 Main Street
CITY=Regina
REGION=SK
POSTAL_CODE=S4P 0A1
COUNTRY=CA
GEO_REGION=CA-SK
GEO_LAT=50.4452
GEO_LNG=-104.6189

# --- home page copy
TITLE=Example Home Services | Same-Day Repairs
DESCRIPTION=Same-day home service in Regina. Flat pricing, licensed and insured. Call today.
EYEBROW=Fast & Reliable
H1=Trusted Home Services in Regina
USP1=Flat pricing, quoted in writing before we start
USP2=Same-day and 24/7 emergency response
USP3=Licensed & insured local technicians
YEAR=2026

# --- FAQ (kept in sync between visible page and FAQPage schema automatically)
FAQ1_Q=Do you offer same-day service?
FAQ1_A=Most days yes — call before 2 PM and there's a good chance we can be out the same afternoon.
FAQ2_Q=How much will it cost?
FAQ2_A=You get one flat price before we start. No meter running, no surprises at the end.
